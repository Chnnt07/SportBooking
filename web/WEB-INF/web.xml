<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>SportBooking</display-name>

    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>controllers.AuthController</servlet-class>
    </servlet>

    <!-- Admin booking -->
    <servlet>
        <servlet-name>AdminBookingController</servlet-name>
        <servlet-class>controllers.AdminBookingController</servlet-class>
    </servlet>

    <!-- Admin courts -->
    <servlet>
        <servlet-name>AdminCourtController</servlet-name>
        <servlet-class>controllers.AdminCourtController</servlet-class>
    </servlet>

    <!-- Servlet URL mappings -->
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminBookingController</servlet-name>
        <url-pattern>/AdminBookingController</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminCourtController</servlet-name>
        <url-pattern>/AdminCourtController</url-pattern>
    </servlet-mapping>

    <!-- Authentication and authorization filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filters.AuthFilter</filter-class>
    </filter>

    <!-- Customer-only court listing: admins must use admin pages. -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/CourtController</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/BookingController</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/MyBookingController</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/AdminBookingController</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/AdminCourtController</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>

</web-app>